# Используем Python
FROM python:3.10-slim

# Рабочая папка внутри контейнера
WORKDIR /app

# Копируем requirements.txt (он лежит рядом с Dockerfile)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем весь код из папки backend внутрь контейнера
COPY . .

# Переменная порта (Render подставит своё значение, но 8000 для локальных тестов)
ENV PORT=8000

# Команда запуска (main.py лежит прямо в корне WORKDIR)
CMD uvicorn main:app --host 0.0.0.0 --port $PORT